{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "percepta-community",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "percepta.moinsen.dev", "custom_domain": true }
  ],
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "logpush": false
}
