{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "percepta-community",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/de/stories/", "/en/stories/", "/de/people/", "/en/people/"],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "percepta.moinsen.dev", "custom_domain": true }
  ],
  "preview_urls": false,
  "vars": { "INTAKE_OPEN": "false", "STORIES_OPEN": "true", "PEOPLE_OPEN": "true", "GITHUB_API_URL": "https://api.github.com" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "percepta-experiences",
    "database_id": "35ba5176-606a-4184-857b-d92b07adf1e0",
    "migrations_dir": "worker/migrations"
  }],
  "ratelimits": [{ "name": "INTAKE_LIMIT", "namespace_id": "2030618739", "simple": { "limit": 10, "period": 60 } }],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": {
    "enabled": false
  },
  "logpush": false
}
