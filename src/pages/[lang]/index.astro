---
import Layout from '../../layouts/Layout.astro';
import { languages, home, pathFor, type Lang } from '../../content/site';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = home[lang];
---
<Layout lang={lang} title={t.title.replace(/\.$/, '')} description={t.description}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <h1 id="hero-title">{t.title}</h1>
    <p class="hero-intro">{t.intro}</p>
    <div class="actions">
      <a class="button" href={pathFor(lang, 'tools')}>{t.findHelp}<span aria-hidden="true"> →</span></a>
      <a class="button secondary" href={pathFor(lang, 'participate')}>{t.share}<span aria-hidden="true"> →</span></a>
    </div>
  </section>
  <section class="section wrap" aria-labelledby="tasks-title">
    <h2 id="tasks-title">{t.tasksTitle}</h2>
    <ul class="task-links">
      {t.tasks.map(([text, id]) => <li><a href={`${pathFor(lang, 'tools')}#${id}`}>{text}<span aria-hidden="true"> →</span></a></li>)}
    </ul>
  </section>
  <section class="story-band" aria-labelledby="why-title">
    <div class="wrap story-content">
      <h2 id="why-title">{t.whyTitle}</h2>
      {t.why.map(text => <p>{text}</p>)}
      <p class="story-signature">{t.whySignature}</p>
    </div>
  </section>
  <section class="section wrap" aria-labelledby="project-title">
    <h2 id="project-title">{t.projectTitle}</h2>
    <p class="lede">{t.project}</p>
    <ol class="steps">{t.steps.map(([title, text]) => <li><h3>{title}</h3><p>{text}</p></li>)}</ol>
    <a href={pathFor(lang, 'about')}>{t.aboutLink}<span aria-hidden="true"> →</span></a>
  </section>
  <section class="section wrap" aria-labelledby="questions-title">
    <h2 id="questions-title">{lang === 'de' ? 'Häufige Fragen' : 'Common questions'}</h2>
    <div class="prose">{t.questions.map(([question, answer]) => <section><h3>{question}</h3><p>{answer}</p></section>)}</div>
  </section>
  <section class="invitation wrap" aria-labelledby="invitation-title"><div><h2 id="invitation-title">{t.readyTitle}</h2><p>{t.ready}</p></div><a class="button" href={pathFor(lang, 'participate')}>{t.share}<span aria-hidden="true"> →</span></a></section>
</Layout>
