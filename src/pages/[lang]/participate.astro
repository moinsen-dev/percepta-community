---
import Layout from '../../layouts/Layout.astro';
import Template from '../../components/Template.astro';
import ExperienceForm from '../../components/ExperienceForm.astro';
import { templates } from '../../content/templates';
import { languages, labels, pathFor, type Lang } from '../../content/site';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = lang === 'de' ? {
  title: 'Erzähl uns von deinem Alltag.',
  intro: 'Eine Situation genügt: Was wolltest du tun, was hat geholfen, was war schwierig? Du brauchst keine technische Idee und kein Konto. Du kannst jede Frage auslassen und jederzeit aufhören.',
  choices: 'Wähle deinen Weg',
  promptLink: 'Im Gespräch mit einer KI', promptLinkText: 'Eine KI-App wie ChatGPT oder Gemini fragt nach und schreibt am Ende mit dir einen kurzen Text. Das geht auch per Sprache.',
  reportLink: 'Selbst aufschreiben', reportLinkText: 'Schreib direkt hier auf der Seite, auf Papier oder mit einer vertrauten Person.',
  peopleLink: 'Mit Namen und Foto vorstellen', peopleLinkText: 'Erzähl auf der Seite „Menschen“, wer du bist und wie du deinen Alltag erlebst. Wir melden uns kurz, bevor es erscheint.',
  promptTitle: 'Mit KI: Gesprächsanleitung zum Kopieren',
  promptIntro: 'Kopiere den folgenden Text und füge ihn als erste Nachricht in deine KI-App ein. Danach antwortest du einfach auf die Fragen. Am Ende bekommst du einen kurzen Text und einen Link zurück auf diese Seite.',
  provider: 'Deine KI-App verarbeitet das Gespräch nach den Regeln ihres Anbieters. Percepta sieht dieses Gespräch nicht.',
  manualTitle: 'Ohne KI: Fragen zum Aufschreiben',
  manualIntro: 'Diese Fragen helfen beim Aufschreiben, auch auf Papier. Deinen fertigen Text kannst du ins Eingabefeld einfügen und prüfen.',
  afterTitle: 'Was mit deinem Text passiert',
  after: 'Nichts wird automatisch gesendet, weder aus deiner KI-App noch beim Schreiben hier. Du prüfst deinen Text zuerst in der Vorschau. Danach kannst du ihn ohne deinen Namen als Geschichte veröffentlichen oder als Datei speichern. Was gerade möglich ist, steht direkt am Eingabefeld.',
  later: 'Veröffentlicht wird nur, was du in der Vorschau ausdrücklich freigibst. Bitte lege keine eigenen GitHub-Issues mit persönlichen Geschichten an; dort wärst du mit deinem Konto sichtbar. Mitmachen können Erwachsene.',
} : {
  title: 'Tell us about your everyday life.',
  intro: 'One situation is enough: what did you want to do, what helped, what was difficult? You need no technical idea and no account. Skip any question and stop whenever you like.',
  choices: 'Choose your way',
  promptLink: 'In a conversation with an AI', promptLinkText: 'An AI app such as ChatGPT or Gemini asks follow-up questions and writes a short text with you at the end. This also works by voice.',
  reportLink: 'Write it yourself', reportLinkText: 'Write directly on this page, on paper or with someone you trust.',
  peopleLink: 'Introduce yourself with name and photo', peopleLinkText: 'Tell who you are and how you experience everyday life on the “People” page. We get in touch briefly before it appears.',
  promptTitle: 'With AI: conversation guide to copy',
  promptIntro: 'Copy the text below and paste it as the first message into your AI app. Then simply answer the questions. At the end you get a short text and a link back to this page.',
  provider: 'Your AI app processes the conversation under its provider’s rules. Percepta does not see this conversation.',
  manualTitle: 'Without AI: questions to write about',
  manualIntro: 'These questions help you write, on paper too. You can paste your finished text into the input area and review it.',
  afterTitle: 'What happens to your text',
  after: 'Nothing is sent automatically, neither from your AI app nor while you write here. You review your text in a preview first. Then you can publish it as a story without your name or save it as a file. The input area tells you what is currently possible.',
  later: 'Only what you explicitly approve in the preview is published. Please do not open your own GitHub issues with personal stories; your account would be visible there. Taking part is for adults.',
};
---
<Layout lang={lang} page="participate" title={lang === 'de' ? 'Alltagserfahrungen beschreiben und mitgestalten' : 'Describe everyday experiences and help shape Percepta'} description={t.intro}>
  <article class="article wrap">
    <header class="article-header"><p class="eyebrow">{labels[lang].participate}</p><h1>{t.title}</h1><p class="lede">{t.intro}</p></header>
    <div class="prose">
      <section aria-labelledby="choices-title"><h2 id="choices-title">{t.choices}</h2>
        <ul class="choice-list">
          <li><a href="#prompt">{t.promptLink}</a><p>{t.promptLinkText}</p></li>
          <li><a href="#write">{t.reportLink}</a><p>{t.reportLinkText}</p></li>
          <li><a href={`${pathFor(lang, 'people')}#vorstellen`}>{t.peopleLink}</a><p>{t.peopleLinkText}</p></li>
        </ul>
      </section>
      <section id="prompt" aria-labelledby="prompt-title"><h2 id="prompt-title">{t.promptTitle}</h2><p>{t.promptIntro}</p><p class="notice">{t.provider}</p>
        <Template id="prompt" text={templates[lang].prompt} lang={lang} />
      </section>
      <div id="write">
      <ExperienceForm lang={lang} />
      <noscript><p class="notice">{lang === 'de' ? 'Eingabefeld, Vorschau und Senden benötigen JavaScript. Die Fragen unten kannst du auch ohne JavaScript lesen und herunterladen. Dadurch wird nichts gesendet.' : 'The input area, preview and sending need JavaScript. You can read and download the questions below without JavaScript. This does not send anything.'}</p></noscript>
      <section id="manual" aria-labelledby="manual-title"><h2 id="manual-title">{t.manualTitle}</h2><p>{t.manualIntro}</p>
        <Template id="manual" text={templates[lang].manual} lang={lang} />
      </section>
      </div>
      <section><h2>{t.afterTitle}</h2><p>{t.after}</p><p>{t.later}</p><a href={pathFor(lang, 'privacy')}>{labels[lang].privacy}</a></section>
    </div>
  </article>
</Layout>
