---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title="Alltagshilfen für blinde Menschen / Everyday assistance for blind people" description="Hilfreiche Apps entdecken und Alltagshilfen mitgestalten. Discover useful apps and help shape everyday assistance. Deutsch / English." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="language-choice">
      <p class="brand"><span class="brand-mark" aria-hidden="true">p.</span>percepta</p>
      <h1>Alltag verstehen.<br /><span lang="en">Understand everyday life.</span></h1>
      <p>Alltagshilfen gemeinsam mit blinden und sehbehinderten Menschen erforschen.</p>
      <p lang="en">Exploring everyday assistance with blind and low-vision people.</p>
      <nav aria-label="Sprache / Language" class="actions">
        <a class="button" href="/de/" lang="de" hreflang="de">Auf Deutsch lesen</a>
        <a class="button secondary" href="/en/" lang="en" hreflang="en">Read in English</a>
      </nav>
      <p class="legal-links"><a href="/de/imprint/">Impressum</a> · <a href="/de/privacy/">Datenschutz</a> · <a href="/en/imprint/" lang="en">Legal notice</a> · <a href="/en/privacy/" lang="en">Privacy</a></p>
    </main>
  </body>
</html>
